rule "Nalaz papule i pustule bez komedona"
    @source("Wilkin 2002, NRS")
    @opis("Prijavljene papule i pustule bez komedona")
    agenda-group "diagnosis"
    salience 30
when
    DataReady($id : userId)
    RosaceaAnswers(userId == $id, papulesPustulesWithoutComedones)
    not Nalaz(userId == $id, code == NalazCode.PAPULE_PUSTULE_BEZ_KOMEDONA)
