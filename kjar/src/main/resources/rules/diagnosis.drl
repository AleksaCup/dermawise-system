rule "Nalaz flushing iz upitnika"
    @source("Wilkin 2002, NRS")
    @opis("Flushing bar dva puta nedeljno prema upitniku")
    agenda-group "diagnosis"
    salience 30
when
    DataReady($id : userId)
    RosaceaAnswers(userId == $id, flushingPerWeek >= Thresholds.FLUSHING_PER_WEEK)
    not Nalaz(userId == $id, code == NalazCode.FLUSHING_UPITNIK)
then
    insert(new Nalaz($id, NalazCode.FLUSHING_UPITNIK));
end

