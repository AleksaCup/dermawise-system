rule "Nalaz flushing iz upitnika"
    @source("Wilkin 2002, NRS")
    @opis("Flushing bar dva puta nedeljno prema upitniku")
    agenda-group "diagnosis"
    salience 30
when
    DataReady($id : userId)
    RosaceaAnswers(userId == $id, flushingPerWeek >= Thresholds.FLUSHING_PER_WEEK)
    not Nalaz(userId == $id, code == NalazCode.FLUSHING_UPITNIK)
then
    insert(new Nalaz($id, NalazCode.FLUSHING_UPITNIK));
end

rule "Nalaz skorašnji steroid iz proizvoda"
    @source("Wilkin 2002, NRS")
    @opis("Proizvod u upotrebi sadrži sastojak iz grupe topijskih kortikosteroida (backward upit pripada)")
    agenda-group "diagnosis"
    salience 30
when
    DataReady($id : userId)
    LifestyleAnswers(userId == $id, $proizvodi : currentProducts)
    $proizvod : Product() from $proizvodi
    ProductIngredient($sastojak : name) from $proizvod.ingredients
    pripada($sastojak, "topijski kortikosteroidi";)
    not Nalaz(userId == $id, code == NalazCode.SKORASNJI_STEROID)
then
    insert(new Nalaz($id, NalazCode.SKORASNJI_STEROID));
end

rule "Nalaz flushing iz dnevnika"
    @source("Wilkin 2002, NRS")
    @opis("Backward upit TranzijentniEritem: bar dve epizode u 7 dana uz tipičan okidač")
    agenda-group "diagnosis"
    salience 30
when
    DataReady($id : userId)
    TranzijentniEritem($id;)
    not Nalaz(userId == $id, code == NalazCode.FLUSHING_DNEVNIK)
then
    insert(new Nalaz($id, NalazCode.FLUSHING_DNEVNIK));
end

rule "Nalaz okularni simptomi"
    @source("Wilkin 2002, NRS")
    @opis("Prijavljeni simptomi oka (peckanje, crvenilo, suvoća)")
    agenda-group "diagnosis"
    salience 30
when
    DataReady($id : userId)
    RosaceaAnswers(userId == $id, ocularSymptoms)
    not Nalaz(userId == $id, code == NalazCode.OKULARNI_SIMPTOMI)
then
    insert(new Nalaz($id, NalazCode.OKULARNI_SIMPTOMI));
end

