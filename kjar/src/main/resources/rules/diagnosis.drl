package rules;

import com.ftn.sbnz.kjar.Thresholds;
import com.ftn.sbnz.model.enums.Condition;
import com.ftn.sbnz.model.enums.LesionType;
import com.ftn.sbnz.model.enums.RosaceaSubtype;
import com.ftn.sbnz.model.enums.Severity;
import com.ftn.sbnz.model.facts.DataReady;
import com.ftn.sbnz.model.facts.Diagnosis;
import com.ftn.sbnz.model.facts.Nalaz;
import com.ftn.sbnz.model.facts.NalazCode;
import com.ftn.sbnz.model.facts.RosaceaPrimaryCriterion;
import com.ftn.sbnz.model.facts.SeverityCategory;
import com.ftn.sbnz.model.facts.SeverityScore;
import com.ftn.sbnz.model.questionnaire.RegionLesion;
import com.ftn.sbnz.model.questionnaire.RosaceaAnswers;
import com.ftn.sbnz.model.questionnaire.ScoradAnswers;

function Severity rosaceaSeverity(RosaceaAnswers a) {
    int highest = Math.max(
            Math.max(a.getFlushingGrade(), a.getPersistentErythemaGrade()),
            Math.max(a.getTelangiectasiaGrade(), a.getPapulesPustulesGrade()));
    if (highest >= 3) {
        return Severity.SEVERE;
    }
    if (highest == 2) {
        return Severity.MODERATE;
    }
    return Severity.MILD;
}

function double scorad(ScoradAnswers s) {
    double value = s.getAffectedAreaPercent() / 5 + 7.0 * s.getIntensitySum() / 2 + s.getSubjectiveSum();
    return Math.round(value * 10) / 10.0;
}

rule "GAGS skor"
    @source("Doshi 1997, GAGS")
    @opis("GAGS skor je zbir težine regiona puta ocene najteže lezije u regionu")
    agenda-group "diagnosis"
when
    DataReady($id : userId)
    not SeverityScore(userId == $id, scale == "GAGS")
    Number($gags : intValue) from accumulate(
        RegionLesion(userId == $id, $region : region, $lesion : lesion),
        sum($region.getWeight() * $lesion.getGrade()))
then
    insert(new SeverityScore($id, "GAGS", $gags));
end

rule "Akne prema GAGS kategoriji"
    @source("Doshi 1997, GAGS")
    @opis("Dijagnoza akni sa težinom iz GAGS kategorije")
    agenda-group "diagnosis"
when
    SeverityCategory($id : userId, scale == "GAGS", $severity : severity)
    SeverityScore(userId == $id, scale == "GAGS", $gags : value)
    not Diagnosis(userId == $id, condition == Condition.ACNE)
then
    insert(new Diagnosis($id, Condition.ACNE, $severity, null, $gags));
end

rule "SCORAD skor"
    @source("ETFAD 1993, SCORAD")
    @opis("SCORAD = A/5 + 7B/2 + C (površina, intenzitet znakova, subjektivni simptomi)")
    agenda-group "diagnosis"
when
    DataReady($id : userId)
    $answers : ScoradAnswers(userId == $id)
    not SeverityScore(userId == $id, scale == "SCORAD")
then
    insert(new SeverityScore($id, "SCORAD", scorad($answers)));
end

rule "Atopijski dermatitis prema SCORAD kategoriji"
    @source("ETFAD 1993, SCORAD")
    @opis("Dijagnoza atopijskog dermatitisa sa težinom iz SCORAD kategorije")
    agenda-group "diagnosis"
when
    SeverityCategory($id : userId, scale == "SCORAD", $severity : severity)
    SeverityScore(userId == $id, scale == "SCORAD", $value : value)
    not Diagnosis(userId == $id, condition == Condition.ATOPIC_DERMATITIS)
then
    insert(new Diagnosis($id, Condition.ATOPIC_DERMATITIS, $severity, null, $value));
end


rule "Nalaz komedoni"
    @source("Doshi 1997, GAGS")
    @opis("Bar jedan region ima komedone")
    agenda-group "diagnosis"
    salience 30
when
    DataReady($id : userId)
    exists RegionLesion(userId == $id, lesion == LesionType.COMEDONES)
    not Nalaz(userId == $id, code == NalazCode.KOMEDONI)
then
    insert(new Nalaz($id, NalazCode.KOMEDONI));
end

rule "Nalaz perzistentni eritem"
    @source("Wilkin 2002, NRS")
    @opis("Prijavljen perzistentni eritem")
    agenda-group "diagnosis"
    salience 30
when
    DataReady($id : userId)
    RosaceaAnswers(userId == $id, persistentErythema)
    not Nalaz(userId == $id, code == NalazCode.PERZISTENTNI_ERITEM)
then
    insert(new Nalaz($id, NalazCode.PERZISTENTNI_ERITEM));
end

