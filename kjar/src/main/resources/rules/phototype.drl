package rules;

import java.util.Set;

import com.ftn.sbnz.model.enums.EthnicOrigin;
import com.ftn.sbnz.model.enums.EyeColor;
import com.ftn.sbnz.model.enums.HairColor;
import com.ftn.sbnz.model.enums.SkinColor;
import com.ftn.sbnz.model.enums.SunReaction;
import com.ftn.sbnz.model.enums.TanTendency;
import com.ftn.sbnz.model.facts.DataReady;
import com.ftn.sbnz.model.facts.MEDValue;
import com.ftn.sbnz.model.facts.QuestionnaireSubmitted;
import com.ftn.sbnz.model.facts.SafetyNote;
import com.ftn.sbnz.model.facts.User;
import com.ftn.sbnz.model.questionnaire.LifestyleAnswers;
import com.ftn.sbnz.model.questionnaire.PhototypeAnswers;
import com.ftn.sbnz.model.questionnaire.RegionLesion;
import com.ftn.sbnz.model.questionnaire.RosaceaAnswers;
import com.ftn.sbnz.model.questionnaire.ScoradAnswers;

function int lightMarkers(PhototypeAnswers a) {
    int count = 0;
    if (a.getSkinColor() == SkinColor.VERY_FAIR || a.getSkinColor() == SkinColor.FAIR) {
        count++;
    }
    if (a.getEyeColor() == EyeColor.BLUE || a.getEyeColor() == EyeColor.GREY || a.getEyeColor() == EyeColor.GREEN) {
        count++;
    }
    if (a.getHairColor() == HairColor.RED || a.getHairColor() == HairColor.BLONDE) {
        count++;
    }
    if (a.getEthnicOrigin() == EthnicOrigin.NORTHERN_EUROPEAN) {
        count++;
    }
    return count;
}

function int darkMarkers(PhototypeAnswers a) {
    int count = 0;
    if (a.getSkinColor() == SkinColor.DARK_BROWN || a.getSkinColor() == SkinColor.BLACK) {
        count++;
    }
    if (a.getEyeColor() == EyeColor.DARK_BROWN) {
        count++;
    }
    if (a.getHairColor() == HairColor.BLACK) {
        count++;
    }
    if (a.getEthnicOrigin() == EthnicOrigin.AFRICAN) {
        count++;
    }
    return count;
}

rule "Upitnik spreman"
    @source("DermaWise upitnik")
    @opis("Svi delovi upitnika su popunjeni, analiza može da počne")
    agenda-group "phototype"
when
    QuestionnaireSubmitted($id : userId)
    not DataReady(userId == $id)
    PhototypeAnswers(userId == $id)
    RosaceaAnswers(userId == $id)
    ScoradAnswers(userId == $id)
    LifestyleAnswers(userId == $id)
    Set(size == 6) from accumulate(
        RegionLesion(userId == $id, $region : region),
        collectSet($region))
then
    insert(new DataReady($id));
end

rule "Fototip I"
    @source("Fitzpatrick 1975")
    @opis("Uvek opekotine i nikad preplanulost: fototip I")
    agenda-group "phototype"
when
    DataReady($id : userId)
    PhototypeAnswers(userId == $id, sunReaction == SunReaction.ALWAYS_BURNS, tanTendency == TanTendency.NEVER)
    $u : User(id == $id, fototip == 0)
then
    modify($u) { setFototip(1) }
end

rule "Fototip II"
    @source("Fitzpatrick 1975")
    @opis("Uvek opekotine uz slabu preplanulost: fototip II")
    agenda-group "phototype"
when
    DataReady($id : userId)
    PhototypeAnswers(userId == $id, sunReaction == SunReaction.ALWAYS_BURNS, tanTendency != TanTendency.NEVER)
    $u : User(id == $id, fototip == 0)
then
    modify($u) { setFototip(2) }
end

rule "Fototip III"
    @source("Fitzpatrick 1975")
    @opis("Povremene opekotine pa postepena preplanulost: fototip III")
    agenda-group "phototype"
when
    DataReady($id : userId)
    PhototypeAnswers(userId == $id, sunReaction == SunReaction.BURNS_THEN_TANS)
    $u : User(id == $id, fototip == 0)
then
    modify($u) { setFototip(3) }
end

rule "Fototip IV"
    @source("Fitzpatrick 1975")
    @opis("Retke opekotine i brza preplanulost: fototip IV")
    agenda-group "phototype"
when
    DataReady($id : userId)
    PhototypeAnswers(userId == $id, sunReaction == SunReaction.RARELY_BURNS)
    $u : User(id == $id, fototip == 0)
then
    modify($u) { setFototip(4) }
end

rule "Fototip V"
    @source("Fitzpatrick 1975")
    @opis("Bez opekotina, koža nije tamnosmeđa ni crna: fototip V")
    agenda-group "phototype"
when
    DataReady($id : userId)
    PhototypeAnswers(userId == $id, sunReaction == SunReaction.NEVER_BURNS,
                     skinColor not in (SkinColor.DARK_BROWN, SkinColor.BLACK))
    $u : User(id == $id, fototip == 0)
then
    modify($u) { setFototip(5) }
end

rule "Fototip VI"
    @source("Fitzpatrick 1975")
    @opis("Bez opekotina, tamnosmeđa ili crna koža: fototip VI")
    agenda-group "phototype"
when
    DataReady($id : userId)
    PhototypeAnswers(userId == $id, sunReaction == SunReaction.NEVER_BURNS,
                     skinColor in (SkinColor.DARK_BROWN, SkinColor.BLACK))
    $u : User(id == $id, fototip == 0)
then
    modify($u) { setFototip(6) }
end

rule "MED za fototip"
    @source("Fitzpatrick 1975")
    @opis("Minimalna eritemska doza (MED) određena prema fototipu")
    agenda-group "phototype"
when
    $u : User(fototip > 0, med == 0, $tip : fototip)
    MEDValue(fototip == $tip, $med : value)
then
    modify($u) { setMed($med) }
end

rule "Svetla predispozicija uz tamni fototip"
    @source("Fitzpatrick 1975")
    @opis("Boja kože, očiju, kose i poreklo ukazuju na svetliji tip od izračunatog")
    agenda-group "phototype"
when
    $a : PhototypeAnswers($id : userId, lightMarkers(this) >= 3)
    User(id == $id, fototip >= 5, $tip : fototip) @watch(fototip)
then
    insert(new SafetyNote($id,
        "Boja kože, očiju i kose ne odgovara fototipu " + $tip + ". Proverite odgovor o reakciji na sunce.",
        "Fitzpatrick 1975"));
end

rule "Tamna predispozicija uz svetli fototip"
    @source("Fitzpatrick 1975")
    @opis("Boja kože, očiju, kose i poreklo ukazuju na tamniji tip od izračunatog")
    agenda-group "phototype"
when
    $a : PhototypeAnswers($id : userId, darkMarkers(this) >= 3)
    User(id == $id, fototip > 0, fototip <= 2, $tip : fototip) @watch(fototip)
then
    insert(new SafetyNote($id,
        "Boja kože, očiju i kose ne odgovara fototipu " + $tip + ". Proverite odgovor o reakciji na sunce.",
        "Fitzpatrick 1975"));
end
