package rules;

import com.ftn.sbnz.kjar.Thresholds;
import com.ftn.sbnz.model.diary.FlushingSummary;
import com.ftn.sbnz.model.diary.NoviProizvod;
import com.ftn.sbnz.model.diary.SkinSymptom;
import com.ftn.sbnz.model.enums.FlushTrigger;
import com.ftn.sbnz.model.enums.SymptomType;
import com.ftn.sbnz.model.enums.VezaType;
import com.ftn.sbnz.model.facts.Dokazuje;
import com.ftn.sbnz.model.facts.IngredientGroup;
import com.ftn.sbnz.model.facts.Nalaz;
import com.ftn.sbnz.model.facts.SeverityScore;
import com.ftn.sbnz.model.facts.Veza;
import com.ftn.sbnz.model.questionnaire.LifestyleAnswers;
import com.ftn.sbnz.model.questionnaire.Product;
import com.ftn.sbnz.model.questionnaire.ProductIngredient;

query dokazano(String korisnik, String cilj, String preko)
    Nalaz(korisnik, cilj; preko := code)
    or
    ( Dokazuje($dete, cilj;) and dokazano(korisnik, $dete, preko;) )
end

query PrimarniZnakRosaceje(String korisnik, String znak)
    dokazano(korisnik, "PRIMARNI_ZNAK", znak;)
end

query TranzijentniEritem(String korisnik)
    $summary : FlushingSummary(korisnik; last7Days >= Thresholds.FLUSHING_PER_WEEK)
    exists FlushTrigger(this in (FlushTrigger.HRANA, FlushTrigger.ALKOHOL, FlushTrigger.TOPLOTA)) from $summary.triggers
end

query imaRosaceju(String korisnik)
    PrimarniZnakRosaceje(korisnik, $znak;)
    Nalaz(korisnik, "CENTROFACIJALNA_DISTRIBUCIJA";)
    not Nalaz(korisnik, "KOMEDONI";)
end

query imaAkne(String korisnik)
    Nalaz(korisnik, "KOMEDONI"; $znak : code)
    SeverityScore(userId == korisnik, scale == "GAGS", value > 0)
end

query imaPerioralniDermatitis(String korisnik)
    Nalaz(korisnik, "PERIORALNE_PAPULE";)
    Nalaz(korisnik, "PERIORALNA_DISTRIBUCIJA";)
    not Nalaz(korisnik, "TELANGIEKTAZIJE";)
    Nalaz(korisnik, "SKORASNJI_STEROID"; $znak : code)
end

query povezan(String x, String y)
    Veza(x, y;)
    or
    ( Veza(x, $z;) and povezan($z, y;) )
end

query sadrzi(String x, String y)
    Veza(x, y; type != VezaType.MEMBER_OF)
    or
    ( Veza(x, $z; type != VezaType.MEMBER_OF) and sadrzi($z, y;) )
end

query pripada(String sastojak, String grupa)
    povezan(sastojak, grupa;)
end

query ProizvodSadrzi(Product proizvod, String sastojak)
    ProductIngredient(sastojak := name) from proizvod.ingredients
    or
    ( ProductIngredient($naveden : name) from proizvod.ingredients and sadrzi($naveden, sastojak;) )
end

query UpisanaAlergija(String korisnik, String sastojak)
    LifestyleAnswers(userId == korisnik, $alergije : allergies)
    ( String(this == sastojak) from $alergije
      or
      ( $alergija : String() from $alergije and povezan(sastojak, $alergija;) ) )
end

query UnakrsnaReaktivnost(String korisnik, String sastojak)
    LifestyleAnswers(userId == korisnik, $alergije : allergies)
    $alergija : String(this != sastojak) from $alergije
    IngredientGroup($grupa : name, crossReactive)
    povezan(sastojak, $grupa;)
    povezan($alergija, $grupa;)
end

query PoznatAlergen(String korisnik, String sastojak)
    UpisanaAlergija(korisnik, sastojak;)
    or
    UnakrsnaReaktivnost(korisnik, sastojak;)
end

query DistribucijaOdgovaraPrimeni(String korisnik, Product proizvod)
    exists SkinSymptom(korisnik; type in (SymptomType.ERYTHEMA, SymptomType.STINGING, SymptomType.ITCHING),
                       location memberOf proizvod.applicationAreas)
end

query uzrocnikKontaktnogDermatitisa(String korisnik, String sastojak)
    NoviProizvod(korisnik; daysSinceIntroduced <= 14, $proizvod : proizvod)
    ProizvodSadrzi($proizvod, sastojak;)
    PoznatAlergen(korisnik, sastojak;)
    DistribucijaOdgovaraPrimeni(korisnik, $proizvod;)
end
